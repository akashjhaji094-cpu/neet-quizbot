# =================================================================
# NEET QuizBot Configuration
# =================================================================

# Telegram Bot API Token obtained from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE

# PostgreSQL Database Connection URL (Required for production)
# Heroku / Railway / Render format: postgresql://username:password@hostname:5432/dbname
# SQLite fallback for local development: sqlite:///./quizbot.db
DATABASE_URL=postgresql://quizbot_user:quizbot_password@localhost:5432/quizbot_db

# Bot Username without @ (Optional - retrieved dynamically via API if empty)
BOT_USERNAME=NeetQuizBot

# Webhook URL (For Production Deployment e.g. Heroku, Render, VPS)
# If left blank, the bot runs in Long-Polling mode (recommended for local dev)
WEBHOOK_URL=https://your-quizbot-app.herokuapp.com

# HTTP Webhook Port (Heroku assigns this automatically via $PORT)
PORT=8000

# Comma-separated Telegram User IDs for Admin/Owner Operations (receives /stats access)
ADMIN_USER_IDS=123456789

# Bot Owner Telegram Username without @ (e.g. akashjhaji)
OWNER_USERNAME=your_telegram_username

# Support Link or Channel/Group URL (e.g. https://t.me/your_support_group)
SUPPORT_URL=https://t.me/your_support_group

# Default bot language (en or hi)
DEFAULT_LANGUAGE=en

# Environment (development or production)
ENVIRONMENT=development

# Debug SQL Logging (True or False)
DEBUG=False
